# Photo Backup System Configuration
# 
# This is an example configuration file for the photo backup system.
# Copy this file to config.yaml and modify the settings for your environment.
#
# For production use:
# 1. Update the source_path to your photo directory
# 2. Configure your Wasabi credentials in 1Password
# 3. Adjust monitoring intervals as needed
#
# For testing:
# 1. Use --test-mode flag to override with test settings
# 2. Test mode uses Minio instead of Wasabi
# 3. Test mode uses temporary directories

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
backup:
  # Source directory containing photos to backup
  # Production: External drive mount point
  # Example: "/Volumes/4TB-SSD/Photo" or "/Volumes/MyPhotos/Pictures"
  source_path: "/Volumes/4TB-SSD/Photo"
  
  # Destination for backup (rclone remote:bucket format)
  # Production: Wasabi S3 bucket
  destination: "wasabi-photo:my-photo-backup-bucket"

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================
storage:
  # S3-compatible storage endpoint
  # Production: Wasabi endpoint
  endpoint: "s3.wasabisys.com"
  
  # Credentials (retrieved from 1Password in production)
  # Do not put actual credentials in this file!
  # Production credentials are fetched from 1Password CLI
  access_key: null  # Retrieved from 1Password
  secret_key: null  # Retrieved from 1Password
  
  # Use SSL/TLS for connections
  use_ssl: true

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================
monitoring:
  # How often to check for changes (in hours)
  # Production: 4 hours between checks
  check_interval_hours: 4
  
  # Delay after drive mount before starting backup (in minutes)
  # Allows drive to fully mount and settle
  mount_delay_minutes: 15
  
  # Delay after detecting changes before starting backup (in minutes)
  # Allows file operations to complete
  change_delay_minutes: 30

# =============================================================================
# VERIFICATION CONFIGURATION
# =============================================================================
verification:
  # Day of month to run full verification (1-28)
  monthly_day: 1
  
  # Automatically repair mismatched files
  auto_repair: true

# =============================================================================
# RCLONE CONFIGURATION
# =============================================================================
rclone:
  # Number of parallel transfers
  transfers: 8
  
  # Number of parallel checkers
  checkers: 16
  
  # S3 chunk size for multipart uploads
  s3_chunk_size: "10M"
  
  # S3 upload concurrency
  s3_upload_concurrency: 4

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
logging:
  # Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
  # Production: INFO or WARNING
  level: "INFO"
  
  # Maximum log file size in MB
  max_size_mb: 100
  
  # Number of backup log files to keep
  backup_count: 5
  
  # Log directory
  # Production: ~/Library/Logs/photo-backup/
  directory: "~/Library/Logs/photo-backup"

# =============================================================================
# STATE MANAGEMENT
# =============================================================================
state:
  # Directory for storing application state
  # Production: ~/Library/Application Support/photo-backup/
  directory: "~/Library/Application Support/photo-backup"

# =============================================================================
# NOTIFICATIONS
# =============================================================================
notifications:
  # Send error notifications to terminal
  errors_to_terminal: true

# =============================================================================
# TEST MODE OVERRIDES
# =============================================================================
# When running with --test-mode flag, these settings override the above
# This allows testing with Minio instead of Wasabi without changing main config
#
# Test mode features:
# - Uses local Minio server instead of Wasabi
# - Uses temporary directories for photos and state
# - Uses accelerated timers (minutes instead of hours)
# - Uses DEBUG logging for verbose output
# - Uses hardcoded test credentials

test_mode:
  backup:
    source_path: "/tmp/photo-backup-test-photos"
    destination: "minio-test:my-photo-backup-bucket-test"
  
  storage:
    endpoint: "localhost:9000"
    access_key: "minioadmin"
    secret_key: "minioadmin"
    use_ssl: false
  
  monitoring:
    check_interval_hours: 0.1  # 6 minutes for testing
    mount_delay_minutes: 1
    change_delay_minutes: 1
  
  logging:
    level: "DEBUG"
    directory: "/tmp/photo-backup-test/logs"
  
  state:
    directory: "/tmp/photo-backup-test/state"

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================
#
# 1. PRODUCTION SETUP:
#    - Copy this file to config.yaml
#    - Update source_path to your photo directory
#    - Install 1Password CLI and configure Wasabi credentials
#    - Install rclone and configure Wasabi remote
#    - Run: photo-backup validate
#
# 2. TEST SETUP:
#    - Start Minio: docker run -p 9000:9000 minio/minio server /data
#    - Run: photo-backup --test-mode
#    - No additional configuration needed for testing
#
# 3. CREDENTIAL SETUP:
#    - Install 1Password CLI: https://developer.1password.com/docs/cli/get-started/
#    - Store Wasabi credentials in 1Password
#    - The system will retrieve credentials automatically
#
# 4. RCLONE SETUP:
#    - Install rclone: https://rclone.org/install/
#    - Configure Wasabi remote: rclone config
#    - Test connection: rclone ls wasabi-photo:
#